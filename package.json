{
  "name": "keepthis",
  "version": "0.0.1",
  "private": true,
  "description": "A UX regression guard for AI-powered UI changes.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && node scripts/copy-axe.mjs",
    "test": "vitest run",
    "demo:diff": "tsx scripts/demo-diff.ts",
    "demo": "vite demo --port 4173",
    "preview": "vite --port 5180 --open /preview.html"
  },
  "dependencies": {
    "axe-core": "^4.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
